library(EpiExposure)
library(tidyverse)
library(ggplot2)
library(cowplot)
library(dplyr)
library(EpiExposure)
data("epi_data")
head(epi_data)
sim_data = epi_data
sim_data2 = sim_data |>
filter(epi_id <= 480)
sim_data3 = sim_data |>
filter(!epi_id <= 480)
sim_data2$epi_id = as.factor(sim_data2$epi_id)
sim_data3$epi_id = as.factor(sim_data3$epi_id)
### train
cb <- define_exposures(
data = sim_data2,
vars = c("wetness","tmean","rain"),
max_lag = 85,
df_var = 3,
df_lag = 2
)
dat <- build_design(
data = sim_data2,
cb_templates = cb,
max_lag = 85
)
dat <- prepare_response(data = dat, response = "y", family = "beta")
fit <- fit_epidlnm(
data = dat,
model_engine = "glmmTMB",
family = "beta",
random_effect = NULL,
epiexposure_spec = attr(cb, "spec")
)
summary(fit)
fit_vars = attr( fit, "epiexposure_vars", exact = TRUE)
fit_vars
fit_spec = attr( fit, "epiexposure_spec", exact = TRUE)
fit_spec
fit_basis = attr( fit, "epiexposure_basis_objects", exact = TRUE)
fit_basis
# ============================================================
# DIAGNÓSTICO DOS METADADOS DO FIT
# ============================================================
fit_vars <- attr(
fit,
"epiexposure_vars",
exact = TRUE
)
fit_spec <- attr(
fit,
"epiexposure_spec",
exact = TRUE
)
fit_basis <- attr(
fit,
"epiexposure_basis_objects",
exact = TRUE
)
cat("\n--- FIT CLASS ---\n")
print(class(fit))
cat("\n--- FITTED VARIABLES ---\n")
print(fit_vars)
cat("\n--- SPEC NAMES ---\n")
print(names(fit_spec))
cat("\n--- BASIS OBJECT NAMES ---\n")
print(
if (is.null(fit_basis)) {
NULL
} else {
names(fit_basis)
}
)
cat("\n--- SAME VARIABLES: SPEC vs FIT ---\n")
print(
setequal(
names(fit_spec),
fit_vars
)
)
cat("\n--- SAME VARIABLES: BASIS vs FIT ---\n")
print(
if (is.null(fit_basis)) {
NA
} else {
setequal(
names(fit_basis),
fit_vars
)
}
)
cat("\n--- MISSING FROM BASIS ---\n")
print(
if (is.null(fit_basis)) {
fit_vars
} else {
setdiff(
fit_vars,
names(fit_basis)
)
}
)
cat("\n--- EXTRA IN BASIS ---\n")
print(
if (is.null(fit_basis)) {
character(0)
} else {
setdiff(
names(fit_basis),
fit_vars
)
}
)
cat("\n--- BASIS CLASSES ---\n")
print(
if (is.null(fit_basis)) {
NULL
} else {
vapply(
fit_basis,
function(x) {
paste(
class(x),
collapse = " / "
)
},
character(1)
)
}
)
epi_l = summarise_effects(fit = fit, data = sim_data,
scale = "lag", effect_measure = "percent",
uncertainty = TRUE, n_samples = 20,
output = "summary",
at = list (
tmean = seq(15,35, length.out = 1000),
rain = seq(0,15, length.out = 1000),
wetness = seq(0,24, length.out = 1000)))
attr(fit, "epiexposure_vars")
devtools::document()
devtools::load_all()
