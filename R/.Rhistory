epi_l = summarise_effects(fit = fit, data = sim_data,
scale = "lag", effect_measure = "percent",
uncertainty = TRUE, n_samples = 20,
output = "summary",
at = list (
tmean = seq(15,35, length.out = 1000),
rain = seq(0,15, length.out = 1000),
wetness = seq(0,24, length.out = 1000)))
epi_l
lag_plot <- plot_effects(
data = epi_l,
scale = "lag",
var = c("tmean", "rain", "wetness"),
metric = c("effect", "delta"),
delta_multiplier = 100,
ylab = c(
tmean   = "Mean temperature (°C)",
rain    = "Daily precipitation (mm)",
wetness = "Leaf wetness (%)"
)
)
lag_plot
ct = compute_eci(
data = sim_data,
group = "epi_id",
group_level = NULL,
fit = fit,
var = c("tmean", "rain", "wetness"),
scale = "link",
uncertainty = TRUE, n_samples = 10,
output = "summary"
)
ct
ctt = ct |>
filter(var == "wetness")
sim_datact = sim_data |>
group_by(epi_id) |>
summarise(y = mean(y))
ctt$y = sim_datact$y
cor.test(ctt$ECI_weighted, ctt$predicted,
method = "spearman")
eci_weighted = ct |>
ggplot()+
geom_jitter(aes(ECI_weighted,predicted), color = "black")+
geom_smooth(aes(ECI_weighted,predicted),se = F,
linetype = 1, color = "orange")+
geom_smooth(aes(ECI_weighted,predicted_lower),se = F,
linetype = 2, color = "orange")+
geom_smooth(aes(ECI_weighted,predicted_upper),se = F,
linetype = 2, color = "orange")+
theme_bw()+
facet_wrap(~var, nrow = 3, , scales = "free_y")+
labs(
x = "ECI",
y = "Predicted (%)"
)+
theme(text = element_text(size = 10, face = "bold"),
legend.position = "none")
eci_weighted
eci_raw = ct |>
ggplot(aes(ECI_raw))+
geom_histogram(fill = "black", color = "white", bins = 10)+
facet_wrap(~var, nrow = 3, scales = "free_y")+
labs(
x = "ECI unweighted",
y = "Frequency"
)+
theme(text = element_text(size = 10, face = "bold"),
legend.position = "none")+
theme_bw()
plot_grid(eci_weighted,eci_raw,eci_raw_centered, nrow = 1)
eci_raw_centered = ct |>
ggplot(aes(ECI_raw_centered))+
geom_histogram(fill = "black", color = "white", bins = 10)+
facet_wrap(~var, nrow = 3, scales = "free_y")+
labs(
x = "ECI centered",
y = "Frequency"
)+
theme(text = element_text(size = 10, face = "bold"),
legend.position = "none")+
theme_bw()
plot_grid(eci_weighted,eci_raw,eci_raw_centered, nrow = 1)
data("epi_data")
head(epi_data)
sim_data = epi_data
sim_data2 = sim_data |>
filter(epi_id <= 480)
sim_data3 = sim_data |>
filter(!epi_id <= 480)
sim_data2$epi_id = as.factor(sim_data2$epi_id)
sim_data3$epi_id = as.factor(sim_data3$epi_id)
### train
cb <- define_exposures(
data = sim_data2,
vars = c("wetness","tmean","rain"),
max_lag = 85,
df_var = 3,
df_lag = 2
)
dat <- build_design(
data = sim_data2,
cb_templates = cb,
max_lag = 85
)
dat <- prepare_response(data = dat, response = "y", family = "beta")
fit <- fit_epidlnm(
data = dat,
model_engine = "glmmTMB",
family = "beta",
random_effect = NULL,
epiexposure_spec = attr(cb, "spec")
)
epi_l = summarise_effects(fit = fit, data = sim_data,
scale = "lag", effect_measure = "percent",
uncertainty = TRUE, n_samples = 20,
output = "summary",
at = list (
tmean = seq(15,35, length.out = 1000),
rain = seq(0,15, length.out = 1000),
wetness = seq(0,24, length.out = 1000)))
