output = "summary",
at = list (
tmean = seq(15,35, length.out = 1000),
rain = seq(0,15, length.out = 1000),
wetness = seq(0,24, length.out = 1000)))
cb_templates <- define_exposures(
data = sim_data2,
vars = c("wetness", "tmean", "rain"),
max_lag = 85,
df_var = 3,
df_lag = 2
)
design <- build_design(
data = sim_data2,
cb_templates = cb_templates,
max_lag = 85,
include_response = TRUE
)
fit_spec <- attr(
design,
"epiexposure_spec",
exact = TRUE
)
fit_vars <- attr(
design,
"epiexposure_vars",
exact = TRUE
)
if (is.null(fit_vars)) {
fit_vars <- c("wetness", "tmean", "rain")
}
cb_templates <- cb_templates[fit_vars]
fit_spec <- fit_spec[fit_vars]
fit_spec
cb_templates
stopifnot(
is.list(cb_templates),
!is.data.frame(cb_templates),
identical(names(cb_templates), fit_vars),
all(vapply(
cb_templates,
inherits,
logical(1),
what = "crossbasis"
)),
is.list(fit_spec),
identical(names(fit_spec), fit_vars)
)
fit <- fit_epidlnm(
data = design,
model_engine = "glmmTMB",
family = "beta",
epiexposure_spec = fit_spec,
basis_objects = cb_templates
)
fit <- fit_epidlnm(
data = dat,
model_engine = "glmmTMB",
family = "beta",
epiexposure_spec = fit_spec,
basis_objects = cb_templates
)
