tarball,
exdir = extract_dir
)
# Locate the extracted package directory
package_dir <- file.path(
extract_dir,
"EpiExposure"
)
if (!dir.exists(package_dir)) {
stop(
"The extracted EpiExposure directory was not found.",
call. = FALSE
)
}
# List every file
package_files <- list.files(
package_dir,
recursive = TRUE,
full.names = TRUE,
all.files = TRUE,
include.dirs = FALSE,
no.. = TRUE
)
# Obtain sizes
file_sizes <- file.info(package_files)$size
# Create relative paths
relative_paths <- substring(
package_files,
nchar(package_dir) + 2L
)
# Determine top-level directory
top_level <- ifelse(
grepl("/", relative_paths, fixed = TRUE),
sub("/.*$", "", relative_paths),
"[top-level files]"
)
# Assemble the result
tarball_contents <- data.frame(
path = relative_paths,
top_level = top_level,
size_bytes = file_sizes,
size_kb = file_sizes / 1024,
size_mb = file_sizes / 1024^2,
stringsAsFactors = FALSE
)
# Sort individual files from largest to smallest
tarball_contents <- tarball_contents[
order(
tarball_contents$size_bytes,
decreasing = TRUE
),
,
drop = FALSE
]
rownames(tarball_contents) <- NULL
# Summarize by top-level directory
size_by_directory <- stats::aggregate(
size_bytes ~ top_level,
data = tarball_contents,
FUN = sum
)
size_by_directory$size_mb <- (
size_by_directory$size_bytes / 1024^2
)
size_by_directory <- size_by_directory[
order(
size_by_directory$size_bytes,
decreasing = TRUE
),
,
drop = FALSE
]
rownames(size_by_directory) <- NULL
cat(
"\n============================================================\n",
"SIZE BY TOP-LEVEL DIRECTORY\n",
"============================================================\n",
sep = ""
)
print(
size_by_directory,
row.names = FALSE,
digits = 4
)
cat(
"\n============================================================\n",
"30 LARGEST FILES IN THE SOURCE PACKAGE\n",
"============================================================\n",
sep = ""
)
print(
utils::head(
tarball_contents,
30L
),
row.names = FALSE,
digits = 4
)
cat(
"\nTotal extracted size: ",
round(
sum(tarball_contents$size_bytes) / 1024^2,
2
),
" MB\n",
sep = ""
)
cat(
"Compressed tarball size: ",
round(
file.info(tarball)$size / 1024^2,
2
),
" MB\n",
sep = ""
)
