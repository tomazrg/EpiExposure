lag_max = 85,
df_var = 4,
df_lag = 4,
fun_var = "ns",
fun_lag = "ns"
)
t
t2 <- build_design_matrix(sim_data, t, lag_max = 85)
t2 <- build_design_matrix(TargetSpot, t, lag_max = 85)
t2
t2
# ---- Chunk 4: fit linear mixed model ------------------------------
cb_terms <- paste(names(dat)[grepl("^cb_", names(dat))], collapse = " + ")
# ---- Chunk 3: per-epidemic design (one row per epidemic) -------------------
extract_last_cb_row <- function(x, cb_template) {
cb <- dlnm::crossbasis(
x, lag = LAG_MAX,
argvar = attr(cb_template, "argvar"),
arglag = attr(cb_template, "arglag")
)
as.numeric(cb[length(x), ])
}
build_design_for_var <- function(wx_long, var, cb_template, prefix) {
X <- wx_long |>
group_by(epi_id) |>
summarise(cb = list(extract_last_cb_row(.data[[var]], cb_template)),
.groups = "drop")
p  <- length(X$cb[[1]])
nm <- paste0(prefix, seq_len(p))
X  |> mutate(cb = lapply(cb, setNames, nm)) |> tidyr::unnest_wider(cb)
}
X_list <- map(VARS, ~ build_design_for_var(wx_use, .x, cb_templates[[.x]],
prefix = paste0("cb_", .x, "_")))
names(X_list) <- VARS
X <- reduce(X_list, left_join, by = "epi_id")
dat <- epi_use |>
dplyr::select(epi_id, sev, siteyear, year, location, state, latitude, longitude, planting_date, PD85) |>
left_join(X, by = "epi_id")
#dat <- epi_use |>
#dplyr::select(epi_id, sev, siteyear, year, location, state, lat, longitude, planting_date) |>
#  left_join(X, by = "epi_id")
# ---- Chunk 4: fit linear mixed model ------------------------------
cb_terms <- paste(names(dat)[grepl("^cb_", names(dat))], collapse = " + ")
fml <- as.formula(paste0("sev ~ 1 + (1|siteyear) + ", cb_terms))
library(glmmTMB)
dat$sev  = dat$sev/100
fit_tmb <- glmmTMB(
formula = fml,
data = dat,
family = beta_family(link = "logit")
)
summary(fit_tmb)
dat
var <- "tmax"
cb  <- cb_templates[[var]]
cf  <- coef(summary(fit_tmb))$cond[,1]
cf
vc  <- vcov(fit_tmb)$cond
idx     <- grepl("^cb_tmax_", names(cf))
idx
beta
beta    <- cf[idx]
vc_sub  <- vc[idx, idx]
stopifnot(length(beta) == ncol(cb))
cb
stopifnot(nrow(vc_sub) == ncol(cb))
cp <- crosspred(
cb,
coef  = beta,
vcov  = vc_sub,
at    = at_vals,
cen   = P50,
bylag = 1
)
x_all <- wx_use[[var]]
P50   <- quantile(x_all, 0.50, na.rm = TRUE)
# grid usado pelo DLNM
grid <- sort(unique(as.numeric(quantile(
x_all, seq(0.05, 0.95, by = 0.01), na.rm = TRUE
))))
# valores desejados para o heatmap (26 a 30 °C)
#at_vals <- seq(1, 2, length.out = 10000)
at_vals <- seq(29, 34, length.out = 10000)
# ajustar ao range REAL do grid (evita extrapolação)
at_vals <- at_vals[at_vals >= min(grid) & at_vals <= max(grid)]
# ==============================================================
# 3) crosspred EM TODOS OS at_vals (lag‑móvel)
# ==============================================================
cp <- crosspred(
cb,
coef  = beta,
vcov  = vc_sub,
at    = at_vals,
cen   = P50,
bylag = 1
)
cp
devtools::load_all()
set.seed(123)
# ---------------------------
# parâmetros
# ---------------------------
n_epi   <- 400
n_days  <- 86
lags    <- 0:(n_days-1)
# ---------------------------
# função para gerar efeito temporal (mais forte em lags 40–85)
# ---------------------------
lag_effect <- function(lag) {
ifelse(lag < 40,
0.2 * exp(-lag/20),   # efeito fraco inicial
1.2 * exp(-(lag-40)/25))  # efeito forte depois
}
w_lag <- lag_effect(lags)
w_lag <- w_lag / sum(w_lag)  # normalizar
# ---------------------------
# gerando base longa
# ---------------------------
sim_data <- do.call(rbind, lapply(1:n_epi, function(id) {
# clima diário
tmean <- rnorm(n_days, mean = 25, sd = 3)
rain  <- rgamma(n_days, shape = 2, scale = 2)
vpd   <- runif(n_days, min = 0.5, max = 2)
# índice ponderado (efeito maior nos últimos lags)
idx_tmean <- sum(tmean * rev(w_lag))
idx_rain  <- sum(rain  * rev(w_lag))
idx_vpd   <- sum(vpd   * rev(w_lag))
# relação com resposta (não linear leve)
severity <- 30 +
2.5 * idx_tmean +
1.5 * idx_rain -
3.0 * idx_vpd +
rnorm(1, 0, 5)
severity <- max(min(severity, 100), 0)  # limitar 0–100
data.frame(
epi_id = id,
dpp    = 1:n_days,
tmean  = tmean,
rain   = rain,
vpd    = vpd,
y      = severity   # repetido por construção ✅
)
}))
# ---------------------------
# visualizar
# ---------------------------
head(sim_data)
dim(sim_data)
sim_data
sim_data$dpp = sim_data$dpp-1
sim_data
t = define_exposure(
wx_long = TargetSpot,
vars = c("tmean","vpd","rain"),
lag_max = 85,
df_var = 4,
df_lag = 4,
fun_var = "ns",
fun_lag = "ns"
)
t2 <- build_design_matrix(sim_data, t, lag_max = 85)
t3 <- prepare_response(sim_data, y_var = "y", family_choice = "beta")
y_df <- t3 |>
group_by(epi_id) |>
summarise(
y_model = first(y_model),
.groups = "drop"
)
dat_model <- left_join(t2, y_df, by = "epi_id")
fit <- fit_epidlnm(
dat = dat_model,
family = "beta",
model_engine = "glmmTMB"
)
summary(fit)
res <- summarise_effects(
fit,
wx_values = sim_data$tmean,
family_choice = "beta"
)
res <- summarise_effects(
fit,
wx_values = sim_data$tmean,
)
res <- summarise_effects(
fit = fit,
var = "tmax",
lag_max = 85
)
