data = epi_data,
vars = c(
"tmean",
"rain",
"wetness"
),
max_lag = 85,
df_var = 3,
df_lag = 2
)
dat <- build_design(
data = epi_data,
cb_templates = cb,
max_lag = 85
)
dat <- prepare_response(
data = dat,
response = "y",
family = "beta"
)
fit <- fit_epidlnm(
data = dat,
model_engine = "glmmTMB",
family = "beta",
epiexposure_spec = attr(cb,"spec")
)
periods <- define_periods(
max_lag = 85,
cuts = c(
20,
40,
60
)
)
temp_range <- simulate_ranges(
periods = periods,
vary = list(
rain = 5,
wetness = 10,
tmean = seq(
18,
34,
by = 0.5
)
),
scenario_type = "grid",
scenario_var = "tmean"
)
temp_predictions <- simulate_scenarios(
fit = fit,
scenarios = temp_range,
data = epi_data,
uncertainty = TRUE,
output = "summary",
n_samples = 50
)
response_curve <- temp_predictions %>%
transmute(
value = tmean,
prediction = prediction * 100,
lower = prediction_lower * 100,
upper = prediction_upper * 100
) %>%
arrange(value)
ggplot(
response_curve,
aes(
value,
prediction
)
) +
geom_line(
linewidth = 1
) +
theme_bw() +
labs(
x = "Mean temperature (°C)",
y = "Predicted disease (%)"
)
temp_sensitivity <- epi_sensitivity(
data = response_curve,
x = "value",
y = "prediction",
scenario_var = NULL,
elasticity = TRUE,
critical = TRUE,
k = 3)
head(temp_sensitivity)
ggplot(
temp_sensitivity,
aes(
value,
sensitivity
)
) +
geom_line(
linewidth = 1
) +
theme_bw() +
labs(
x = "Mean temperature (°C)",
y = "Sensitivity"
)
ggplot(
temp_sensitivity,
aes(
value,
elasticity
)
) +
geom_line(
linewidth = 1
) +
theme_bw() +
labs(
x = "Mean temperature (°C)",
y = "Elasticity"
)
temp_sensitivity %>%
filter(critical)
ggplot(
temp_sensitivity,
aes(
value,
sensitivity
)
) +
geom_line() +
geom_point(
data = subset(
temp_sensitivity,
critical
),
color = "red",
size = 3
) +
theme_bw()
rain_range <- simulate_ranges(
periods = periods,
vary = list(
tmean = 25,
wetness = 10,
rain = seq(
0,
15,
by = 0.5
)
),
scenario_type = "grid",
scenario_var = "rain"
)
wetness_range <- simulate_ranges(
periods = periods,
vary = list(
tmean = 25,
rain = 5,
wetness = seq(
0,
24,
by = 0.5
)
),
scenario_type = "grid",
scenario_var = "wetness"
)
rain_predictions <- simulate_scenarios(
fit = fit,
scenarios = rain_range,
data = epi_data,
uncertainty = TRUE,
output = "samples",
n_samples = 20
)
wetness_predictions <- simulate_scenarios(
fit = fit,
scenarios = wetness_range,
data = epi_data,
uncertainty = TRUE,
output = "samples",
n_samples = 20
)
sens_rain <- epi_sensitivity(
data = rain_predictions,
x = "rain",
y = "prediction",
scenario_var = "sample",
elasticity = TRUE,
critical = TRUE,
method = "finite",
k = 3
)
sens_wetness <- epi_sensitivity(
data = wetness_predictions,
x = "wetness",
y = "prediction",
scenario_var = "sample",
elasticity = TRUE,
critical = TRUE,
method = "finite",
k = 3
)
sens_rain$variable <- "Rain"
sens_wetness$variable <- "Wetness"
combined <- bind_rows(
sens_rain,
sens_wetness
)
ggplot(
combined,
aes(
value,
sensitivity,
color = variable
)
) +
geom_line(
linewidth = 1
) +
theme_bw()
combined
ggplot(
combined,
aes(
prediction,
sensitivity,
color = variable
)
) +
geom_line(
linewidth = 1
) +
theme_bw()
ggplot(
combined,
aes(
prediction,
sensitivity,
color = variable
)
) +
geom_line(
linewidth = 1
) +
theme_bw()
