vignette_files <- list.files(
"vignettes",
pattern = "\\.Rmd$",
full.names = TRUE
)
vignette_times <- lapply(
vignette_files,
function(file) {
temp_output <- tempfile(fileext = ".md")
timing <- system.time(
knitr::knit(
input = file,
output = temp_output,
quiet = TRUE,
envir = new.env(parent = globalenv())
)
)
if (file.exists(temp_output)) {
unlink(temp_output)
}
data.frame(
vignette = basename(file),
elapsed_seconds = unname(timing[["elapsed"]]),
elapsed_minutes = unname(timing[["elapsed"]]) / 60,
stringsAsFactors = FALSE
)
}
)
vignette_times <- do.call(
rbind,
vignette_times
)
vignette_times <- vignette_times[
order(
vignette_times$elapsed_seconds,
decreasing = TRUE
),
]
print(
vignette_times,
row.names = FALSE
)
