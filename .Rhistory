profile_vignette_chunks <- function(file) {
timing_env <- new.env(parent = emptyenv())
timing_env$start <- list()
timing_env$results <- data.frame(
vignette = character(),
chunk = character(),
elapsed_seconds = numeric(),
elapsed_minutes = numeric(),
stringsAsFactors = FALSE
)
old_hook <- knitr::knit_hooks$get("time_it")
old_time_it <- knitr::opts_chunk$get("time_it")
on.exit(
{
knitr::knit_hooks$set(
time_it = old_hook
)
knitr::opts_chunk$set(
time_it = old_time_it
)
},
add = TRUE
)
knitr::knit_hooks$set(
time_it = function(
before,
options,
envir
) {
label <- options$label
if (before) {
timing_env$start[[label]] <- proc.time()[["elapsed"]]
} else {
start_time <- timing_env$start[[label]]
if (!is.null(start_time)) {
elapsed <- proc.time()[["elapsed"]] - start_time
timing_env$results <- rbind(
timing_env$results,
data.frame(
vignette = basename(file),
chunk = label,
elapsed_seconds = elapsed,
elapsed_minutes = elapsed / 60,
stringsAsFactors = FALSE
)
)
}
}
NULL
}
)
knitr::opts_chunk$set(
time_it = TRUE
)
output_file <- tempfile(
fileext = ".md"
)
knitr::knit(
input = file,
output = output_file,
quiet = TRUE,
envir = new.env(
parent = globalenv()
)
)
if (file.exists(output_file)) {
unlink(output_file)
}
timing_env$results
}
chunk_times <- rbind(
profile_vignette_chunks(
"vignettes/understanding-effects.Rmd"
),
profile_vignette_chunks(
"vignettes/losses.Rmd"
)
)
chunk_times <- chunk_times[
order(
chunk_times$elapsed_seconds,
decreasing = TRUE
),
]
print(
chunk_times,
row.names = FALSE
)
head(
chunk_times,
15
)
subset(
chunk_times,
elapsed_seconds >= 10
)
