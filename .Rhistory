library(EpiExposure)
library(dplyr)
library(ggplot2)
data("epi_data")
cb <- define_exposures(
data = epi_data,
vars = c(
"tmean",
"rain",
"wetness"
),
max_lag = 85,
df_var = 3,
df_lag = 2
)
dat <- build_design(
data = epi_data,
cb_templates = cb,
max_lag = 85
)
dat <- prepare_response(
data = dat,
response = "y",
family = "beta"
)
fit <- fit_epidlnm(
data = dat,
model_engine = "glmmTMB",
family = "beta",
epiexposure_spec = attr(cb,"spec")
)
periods <- define_periods(
max_lag = 85,
cuts = c(
20,
40,
60
)
)
scenario_grid <- simulate_ranges(
periods = periods,
vary = list(
tmean = c(20,34),
rain = seq(0,15),
wetness = c(2,10)
),
scenario_type = "grid",
scenario_var = "rain"
)
predictions <- simulate_scenarios(
fit = fit,
scenarios = scenario_grid,
data = epi_data,
uncertainty = TRUE,
output = "summary",
n_samples = 100
)
