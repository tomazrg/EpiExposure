``
tarball <- devtools::build()
tarball_dir <- tempfile(
pattern = "EpiExposure_tarball_"
)
tarball_summary <- fs::dir_info(
path = package_dir,
recurse = TRUE,
type = "file"
) |>
dplyr::mutate(
relative_path = fs::path_rel(
path,
start = package_dir
),
top_directory = ifelse(
grepl("/", relative_path, fixed = TRUE),
sub("/.*$", "", relative_path),
"(top-level files)"
),
size_mb = as.numeric(size) / 1024^2
) |>
dplyr::group_by(
top_directory
) |>
dplyr::summarise(
files = dplyr::n(),
size_mb = sum(size_mb),
.groups = "drop"
) |>
dplyr::arrange(
dplyr::desc(size_mb)
)
tarball
file.info(
tarball
)$size / 1024^2
