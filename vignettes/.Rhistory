filter(epi_id <= 480)
sim_data3 = sim_data |>
filter(!epi_id <= 480)
sim_data2$epi_id = as.factor(sim_data2$epi_id)
sim_data3$epi_id = as.factor(sim_data3$epi_id)
### train
cb <- define_exposures(
data = sim_data2,
vars = c("wetness","tmean","rain"),
max_lag = 85,
df_var = 3,
df_lag = 2
)
dat <- build_design(
data = sim_data2,
cb_templates = cb,
max_lag = 85
)
dat <- prepare_response(data = dat, response = "y", family = "beta")
fit <- fit_epidlnm(
data = dat,
model_engine = "glmmTMB",
family = "beta",
random_effect = NULL,
epiexposure_spec = attr(cb, "spec")
)
summary(fit)
